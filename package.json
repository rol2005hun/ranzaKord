{
  "name": "ranzakord",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "private": true,
  "scripts": {
    "bump": "git add . && pnpm exec bumpp package.json src-tauri/tauri.conf.json --commit \"build: bump version to v%s\" --all --no-tag --no-push",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "tauri": "tauri",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint . --fix",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "fix": "pnpm run prettier:fix && pnpm run eslint:fix",
    "check": "pnpm run fix && pnpm run prettier:check && pnpm run eslint:check && pnpm run typecheck && pnpm run test --run",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "sync-boilerplate": "tsx sync-boilerplate.ts",
    "youtube:login": "tsx scripts/youtube-login.ts"
  },
  "dependencies": {
    "@pinia/colada": "1.4.8",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@unhead/vue": "^3.4.2",
    "jintr": "^3.3.1",
    "mongoose": "^9.11.1",
    "nuxt": "4.5.2",
    "pinia": "^4.0.3",
    "pinia-orm": "^2.0.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "spotify-url-info": "^3.3.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/flag": "^1.2.12",
    "@iconify-json/fluent": "^1.2.59",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/twemoji": "^1.2.5",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/test-utils": "4.3.3",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "^5.3.16",
    "@pinia/colada-nuxt": "1.2.0",
    "@pinia/nuxt": "1.0.2",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/nuxt": "^15.0.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "^1.87.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "replace-in-file": "^9.0.0",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{vue,js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "vite-plugin-checker": "0.14.5",
      "h3": "1.15.11"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@unhead/vue",
        "pinia",
        "@pinia/nuxt"
      ],
      "allowedVersions": {
        "@unhead/vue": "*",
        "pinia": "*",
        "@pinia/nuxt": "*"
      }
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
